# StarGram Configuration Example
PORT=3000

# Database type: postgres | mysql | local
# If no database host is configured, the application uses local JSON storage.
DB_TYPE=mysql

# Or configure a single connection string:
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/stargram
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/stargram

# MySQL or PostgreSQL connection settings:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stargram
DB_USER=stargram
DB_PASS=change-me

# Initial administrator credentials:
ADMIN_USER=admin
ADMIN_PASS=change-me-too

# Optional AI and proxy settings (also configurable in the admin panel)
GEMINI_API_KEY=
GEMINI_PROXY_URL=
