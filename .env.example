# StarGram Configuration Example
PORT=3000

# نوع دیتابیس: postgres | mysql | local
# اگر خالی بماند و هاستی مشخص نشود، سیستم به صورت خودکار از ذخیره‌سازی محلی (Local JSON Storage) استفاده می‌کند.
DB_TYPE=mysql

# یا آدرس کانکشن استرینگ یکپارچه:
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/stargram
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/stargram

# تنظیمات مجزا برای MySQL یا PostgreSQL:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stargram
DB_USER=stargram
DB_PASS=change-me

# مشخصات اولیه مدیر ارشد:
ADMIN_USER=admin
ADMIN_PASS=change-me-too

# اختیاری: هوش مصنوعی و پروکسی (می‌توان مستقیماً از پنل ادمین نیز تنظیم کرد)
GEMINI_API_KEY=
GEMINI_PROXY_URL=
